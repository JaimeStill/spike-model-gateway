# The gateway's image and ports. scripts/agentgateway-deploy.sh sources it and copies it to gb10-2
# as the compose project's .env, which gateway/agentgateway.yml reads; scripts/currency.sh and the
# step helpers (scripts/clients-lib.sh, scripts/measure-lib.sh) source it too. So it holds plain
# assignments only. The image is pinned here once; `mise run currency` compares its tag with
# agentgateway's latest GitHub release.
AGW_IMAGE=cr.agentgateway.dev/agentgateway:v1.7.0
# The ports of config.yaml's gateways: the consumer port, published on gb10-2's tailnet address,
# where each alias's base URL is http://gb10-2:3000/<alias>/v1; and the UI's, published on its
# loopback.
AGW_PORT=3000
AGW_UI_PORT=3001
