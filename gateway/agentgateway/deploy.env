# What scripts/agentgateway-deploy.sh runs on gb10-2, sourced by it, by scripts/currency.sh, and by
# the step helpers (scripts/clients-lib.sh, scripts/measure-lib.sh). The image is pinned here once;
# `mise run currency` compares its tag with agentgateway's latest GitHub release.
AGW_IMAGE=cr.agentgateway.dev/agentgateway:v1.7.0
# The ports of config.yaml's gateways: the UI's, published on gb10-2's loopback; and one an alias,
# as <alias>:<port>, each published on its tailnet address and each the alias's base URL,
# http://gb10-2:<port>/v1.
AGW_UI_PORT=3001
AGW_ALIAS_PORTS="agent:3010 vision:3011 audio:3012 embedding:3013"
