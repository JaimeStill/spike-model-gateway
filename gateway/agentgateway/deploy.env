# What scripts/agentgateway-deploy.sh runs on gb10-2, sourced by it and by scripts/currency.sh.
# The image is pinned here once; `mise run currency` compares its tag with agentgateway's latest
# GitHub release.
AGW_IMAGE=cr.agentgateway.dev/agentgateway:v1.7.0
# The ports of config.yaml's two gateways: the consumer port, published on gb10-2's tailnet address,
# and the UI's, published on its loopback.
AGW_PORT=3000
AGW_UI_PORT=3001
